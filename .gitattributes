# Normaliza los finales de linea en el repositorio.
* text=auto eol=lf

# Los scripts de shell DEBEN usar LF o fallan en Linux y en los runners.
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.tf   text eol=lf
*.tfvars text eol=lf

# Los scripts de PowerShell se quedan con CRLF.
*.ps1  text eol=crlf
